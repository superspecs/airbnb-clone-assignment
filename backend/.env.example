# Copy to .env and adjust as needed. Never commit .env.

# SQLite file location. Relative paths resolve from the backend/ directory.
# Production: point at a persistent mount with four slashes, e.g. sqlite:////var/data/app.db
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of origins allowed to call the API (exact origin, no trailing slash).
# Production: the deployed frontend origin, e.g. https://<project>.vercel.app
CORS_ORIGINS=http://localhost:3000

# Timezone that defines "today" for date validation.
TIMEZONE=Asia/Kolkata

# Mock service fee in basis points (1200 = 12%).
SERVICE_FEE_BPS=1200

# Create tables and load seed data on startup when the database is empty.
SEED_ON_STARTUP=true
